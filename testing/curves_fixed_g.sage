print('There are', len(function_fields), 'function fields')

def compute_Cf(F):
    return max(ceil(a.degree() / (F.degree() - i)) for i, a in list(enumerate(F.polynomial().coefficients()))[:-1])

min_Cf = min(compute_Cf(F) for F in function_fields)
max_Cf = max(compute_Cf(F) for F in function_fields)

all_function_fields = dict()
all_function_fields[(p, GENUS)] = []

for n in range(3, 9):
    for Cf in range(min_Cf, max_Cf + 1):
        polys_with_Cf = [F for F in function_fields if compute_Cf(F) == Cf and F.degree() == n]
        if len(polys_with_Cf) > 0:
            all_function_fields[(p, GENUS)].append((n, Cf, tuple(str(F.polynomial()).replace('y', 't') for F in polys_with_Cf)))
print(all_function_fields)
